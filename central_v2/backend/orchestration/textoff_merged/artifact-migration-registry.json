      "MISMATCH",
      "MISSING_LEGACY",
      "MISSING_TARGET",
      "NOT_APPLICABLE"
    ],
    "artifact_record_fields": [
      "artifact",
      "size_legacy",
      "size_target",
      "sha256_legacy",
      "sha256_target",
      "comparison_status"
